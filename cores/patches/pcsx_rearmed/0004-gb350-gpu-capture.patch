gb350: capture of the GPU renderer's input (env gated)

GB_GPU_CAPTURE=<file> GB_GPU_CAPTURE_AT=<vblank>,<count> records the VRAM,
the E1-E6 registers, then every command list the renderer consumes, VRAM
uploads and copies, and vblanks, for replaying the drawing elsewhere (the
GB350's second core, corelink). No effect without the variables.

diff --git a/plugins/gpulib/gpu.c b/plugins/gpulib/gpu.c
index f04e3a55..ad46d0e9 100644
--- a/plugins/gpulib/gpu.c
+++ b/plugins/gpulib/gpu.c
@@ -19,6 +19,74 @@
 #include "../../frontend/plugin_lib.h"
 #include "../../include/compiler_features.h"
 
+/*
+ * gb350: capture of the renderer's input, for replaying it elsewhere (the
+ * second core). GB_GPU_CAPTURE=<file> GB_GPU_CAPTURE_AT=<lace>,<count>:
+ * from that vblank on, `count` frames. Run with frameskip off. File (LE
+ * u32s): "GCAP", 1, the 1 MiB VRAM, ex_regs[8]; records: 1 CMD n words,
+ * 2 VRAM_WRITE x y l r6 + l pixels padded to words, 3 VRAM_COPY 4 words,
+ * 4 FRAME lace; 0xffffffff END.
+ */
+static FILE *cap_f;
+static int cap_state;		/* 0 unconfigured, 1 armed, 2 recording, 3 off */
+static uint32_t cap_lace, cap_start, cap_count;
+
+static void cap_u32(uint32_t v)
+{
+  fwrite(&v, 4, 1, cap_f);
+}
+
+static void cap_words(uint32_t tag, const uint32_t *w, uint32_t n)
+{
+  if (cap_state != 2 || !n)
+    return;
+  cap_u32(tag);
+  cap_u32(n);
+  fwrite(w, 4, n, cap_f);
+}
+
+static void cap_vram_write(int x, int y, const uint16_t *mem, int l, uint32_t r6)
+{
+  uint16_t pad = 0;
+  if (cap_state != 2)
+    return;
+  cap_u32(2); cap_u32(x); cap_u32(y); cap_u32(l); cap_u32(r6);
+  fwrite(mem, 2, l, cap_f);
+  if (l & 1)
+    fwrite(&pad, 2, 1, cap_f);
+}
+
+static void cap_frame(struct psx_gpu *gpu)
+{
+  if (cap_state == 0) {
+    const char *at = getenv("GB_GPU_CAPTURE_AT");
+    cap_state = 3;
+    if (getenv("GB_GPU_CAPTURE") && at && sscanf(at, "%u,%u", &cap_start, &cap_count) == 2)
+      cap_state = 1;
+  }
+  if (cap_state == 1 && cap_lace >= cap_start) {
+    cap_f = fopen(getenv("GB_GPU_CAPTURE"), "wb");
+    if (!cap_f) {
+      cap_state = 3;
+      return;
+    }
+    cap_u32(0x50414347); cap_u32(1);
+    fwrite(gpu->vram, 2, 1024 * 512, cap_f);
+    fwrite(gpu->ex_regs, 4, 8, cap_f);
+    cap_state = 2;
+    fprintf(stderr, "gpu capture: started at vblank %u\n", cap_lace);
+  } else if (cap_state == 2) {
+    cap_u32(4); cap_u32(cap_lace);
+    if (cap_lace >= cap_start + cap_count) {
+      cap_u32(0xffffffff);
+      fclose(cap_f);
+      cap_state = 3;
+      fprintf(stderr, "gpu capture: done at vblank %u\n", cap_lace);
+    }
+  }
+  cap_lace++;
+}
+
 #ifndef ARRAY_SIZE
 #define ARRAY_SIZE(x) (sizeof(x) / sizeof((x)[0]))
 #endif
