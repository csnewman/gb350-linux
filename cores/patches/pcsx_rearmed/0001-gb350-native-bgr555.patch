+/*
+ * GB350 frontend: its display takes the PlayStation's native 15-bit BGR
+ * (DRM XBGR1555), so frames can be handed over unconverted. Enabled when
+ * the frontend answers this private environment call with true.
+ */
+#define GB350_ENV_NATIVE_BGR555 0x7f350001
+
+static void gb350_bgr555_copy(void *dst, const void *src, int pixels)
+{
+   memcpy(dst, src, pixels * 2);
+}
+
+static void gb350_bgr888_to_bgr555(void *dst_, const void *src_, int pixels)
+{
+   const unsigned char *s = src_;
+   unsigned short *d = dst_;
+
+   for (; pixels-- > 0; s += 3)
+      *d++ = (s[2] >> 3) << 10 | (s[1] >> 3) << 5 | s[0] >> 3;
+}
