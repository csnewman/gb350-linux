+// gb350: two cores sharing the drawing: skip the stripes of 2^shift rows
+// whose bit (stripe & 31) is set in skip (0 = draw all rows).
+extern "C" void renderer_set_split(int shift, unsigned skip)
+{
+  gpu_unai.inn.split_shift = shift;
+  gpu_unai.inn.split_skip = skip;
+}
