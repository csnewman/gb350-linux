 	                        //  full-screen scaling option is in use ..TODO)
+
+	// gb350: drawing split between two cores by rows. VRAM rows are
+	//  stripes of 2^split_shift rows; stripe s is skipped if bit (s & 31)
+	//  of split_skip is set (0: all rows drawn).
+	u32 split_skip;
+	u8 split_shift;
 };
 
+#define GPU_SPLIT_SKIP(inn, y) \
+	(((inn).split_skip >> ((u32)(y) >> (inn).split_shift & 31)) & 1)
+
