+/* gb350: the frontend may provide the VRAM (memory shared with the second
+ * core); unmap returns 0 for memory that is not its own. */
+void *(*gb350_vram_map)(unsigned int size);
+int (*gb350_vram_unmap)(void *ptr, unsigned int size);
+
+/* gb350: drawing shared with the second core: the unai renderer's hooks
+ * and controls (plugins/gpu_unai/gpulib_if.cpp), through C symbols here. */
+const void *gb350_split;
+void renderer_set_split(int shift, unsigned skip);
+int renderer_split_state(uint32_t *w);
+void renderer_split_resync(void);
+void *renderer_split_vram(void);
+
+void gb350_split_set(int shift, unsigned skip) { renderer_set_split(shift, skip); }
+int gb350_split_state(uint32_t *w) { return renderer_split_state(w); }
+void gb350_split_resync(void) { renderer_split_resync(); }
+void *gb350_split_vram(void) { return renderer_split_vram(); }
+
 static void *pl_mmap(unsigned int size)
 {
+   void *p = gb350_vram_map ? gb350_vram_map(size) : NULL;
+   if (p)
+      return p;
    return psxMap(0, size, 0, MAP_TAG_VRAM);
 }
 
 static void pl_munmap(void *ptr, unsigned int size)
 {
+   if (gb350_vram_unmap && gb350_vram_unmap(ptr, size))
+      return;
    psxUnmap(ptr, size, MAP_TAG_VRAM);
 }
 
