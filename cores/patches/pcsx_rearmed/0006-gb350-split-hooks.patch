gb350: drawing shared with the GB350's second core (frontend hooks)

unai: gb350_split (set by the frontend while it mirrors the drawing to the
second core, which draws the other row stripes, patch 0005, into the same
VRAM): every command drawn, textured primitives before drawing (their
texture may be VRAM the other core drew), renderer_flush_queues (gpulib
reads or writes VRAM next, or scans out) and renderer_update_caches
(gpulib wrote VRAM); renderer_split_state / renderer_set_split_state carry
the drawing options the commands do not.

gpulib: a VRAM read transfer reads its first word at the start: sync the
renderer there.

libretro: gb350_vram_map / gb350_vram_unmap let the frontend provide the
VRAM (corelink memory both cores can address); gb350_split and the
gb350_split_* wrappers give the frontend the renderer's split through C
symbols (a Rust reference to the C++ ones made the LTO link come out
hard-float).

diff --git a/plugins/gpu_unai/gpulib_if.cpp b/plugins/gpu_unai/gpulib_if.cpp
--- a/plugins/gpu_unai/gpulib_if.cpp
+++ b/plugins/gpu_unai/gpulib_if.cpp
@@ -115,8 +115,64 @@
 {
   gpu_unai.inn.split_shift = shift;
   gpu_unai.inn.split_skip = skip;
+}
+
+// gb350: while the frontend mirrors the drawing to the GB350's second core
+// (which draws the other stripes into the same VRAM), it sets these.
+struct gb350_split_ops {
+  void (*texture)(const uint32_t *cmd);            // before a textured primitive
+  void (*command)(const uint32_t *cmd, int words); // after each command drawn
+  void (*flush)(void);    // renderer_flush_queues: gpulib accesses VRAM next
+  void (*written)(void);  // renderer_update_caches: gpulib wrote VRAM
+  void (*state)(void);    // renderer_split_state changed
+};
+// Defined in frontend/libretro.c (the frontend reaches the split through C
+// symbols there).
+extern "C" const struct gb350_split_ops *gb350_split;
+
+// The options the drawing depends on besides the commands (for the other
+// core: renderer_set_split_state). Returns the words written (3), or -1 if
+// the drawing cannot be split (the old renderer).
+extern "C" int renderer_split_state(uint32_t *w)
+{
+  const gpu_unai_config_t &c = gpu_unai.config;
+  if (IS_OLD_RENDERER())
+    return -1;
+  w[0] = c.pixel_skip | c.ilace_force << 1 | c.lighting << 4 | c.fast_lighting << 5 |
+         c.blending << 6 | c.dithering << 7 | c.force_dithering << 8;
+  w[1] = gpu_unai.inn.ilace_mask;
+  w[2] = gpu_unai.prog_ilace_flag;
+  return 3;
+}
+
+extern "C" int renderer_set_split_state(const uint32_t *w, int n)
+{
+  gpu_unai_config_t &c = gpu_unai.config;
+  if (n < 3)
+    return -1;
+  c.pixel_skip = w[0] & 1;
+  c.ilace_force = (w[0] >> 1) & 7;
+  c.lighting = (w[0] >> 4) & 1;
+  c.fast_lighting = (w[0] >> 5) & 1;
+  c.blending = (w[0] >> 6) & 1;
+  c.dithering = (w[0] >> 7) & 1;
+  c.force_dithering = (w[0] >> 8) & 1;
+  gpu_unai.inn.ilace_mask = w[1];
+  gpu_unai.prog_ilace_flag = w[2];
+  return 0;
 }
 
+// The E1-E6 registers through the command hooks (starting a mirror).
+extern "C" void renderer_split_resync(void)
+{
+  renderer_sync_ecmds(gpu.ex_regs);
+}
+
+extern "C" void *renderer_split_vram(void)
+{
+  return gpu.vram;
+}
