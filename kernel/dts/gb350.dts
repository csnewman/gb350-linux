		};

		efuse {
			devpath = "/dev/efuse";
			status = "okay";
		};

		viddec {
			kshm_size = <0x400000>;
		};

		auddec {
			kshm_size = <0xa0000>;
		};
	};

	/*
	 * All 256 MiB (one 2 Gbit DDR3; the bootloader's own map ends at
	 * 0x10000000). The stock firmware gave Linux only up to 0x0af91e50 and
	 * kept the rest for the AVP; what is still used there is reserved
	 * below.
	 */
	memory {
		device_type = "memory";
		reg = <0x00 0x10000000>;
	};

	/*
	 * The gb350-syscore firmware on the second core: shared memory, its
	 * image area (where the bootloader loads cubegm/avp.uImage), the
	 * mailbox blocks and system control (reset bit, trampoline).
	 */
	/*
	 * The gb350-syscore firmware on the second core: message link,
	 * button scanning, power supervision. Its hwspinlock 0 guards GPIO
	 * register read-modify-writes shared by both cores.
	 */
	/*
	 * Memory and work rings shared with the second core (/dev/corelink):
	 * buffers come from CMA on demand, nothing reserved here.
	 */
	corelink {
		compatible = "hichip,gb350-corelink";
	};

	syscore: syscore {
		compatible = "hichip,gb350-syscore";
		#hwlock-cells = <1>;
		pinctrl-names = "default";
		pinctrl-0 = <&syscore_power_pins>;
		reg = <0x0bd00000 0x10000>, <0x0bda4000 0x13c000>,
		      <0x18800800 0x100>, <0x18800000 0x300>, <0x18866800 0x100>;
		interrupt-parent = <0x03>;
		interrupts = <66>;
	};

	/*
	 * Shift-register buttons (DT /panel key-do = L9, key-clk = L8), read
	 * by Linux. Superseded by the second core's scan (syscore-buttons).
	 */
	buttons {
		compatible = "hichip,gb350-keys";
		status = "disabled";
		clk-gpios = <&gpio_l 8 GPIO_ACTIVE_HIGH>;
		data-gpios = <&gpio_l 9 GPIO_ACTIVE_HIGH>;
		poll-interval = <10>;
		/* bit 0 .. 11, mapped by pressing each button */
		linux,keycodes = <BTN_TL BTN_NORTH BTN_WEST BTN_TR
				  BTN_SOUTH BTN_EAST BTN_SELECT BTN_START
				  BTN_DPAD_UP BTN_DPAD_DOWN BTN_DPAD_LEFT BTN_DPAD_RIGHT>;
	};

	/*
	 * Buttons and switches on their own GPIOs (bank L, active low), read by
	 * Linux. Superseded by syscore-buttons.
	 */
	keys {
		compatible = "gpio-keys";
		status = "disabled";

		/* L7/L11: L2/R2 by button test; the bootloader DT calls
		 * them key-shoulder-right/left. */
		button-l2 {
			label = "L2";
			gpios = <&gpio_l 7 GPIO_ACTIVE_LOW>;
			linux,code = <BTN_TL2>;
		};
		button-r2 {
			label = "R2";
			gpios = <&gpio_l 11 GPIO_ACTIVE_LOW>;
			linux,code = <BTN_TR2>;
		};
		button-volume-down {
			label = "Volume Down";
			gpios = <&gpio_l 12 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEDOWN>;
		};
		button-volume-up {
			label = "Volume Up";
			gpios = <&gpio_l 13 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEUP>;
		};
		button-power {
			label = "Power";
			gpios = <&gpio_l 14 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_POWER>;
			wakeup-source;
		};
		button-fn {
			label = "Fn";	/* bootloader DT /panel key-fn */
			gpios = <&gpio_l 2 GPIO_ACTIVE_LOW>;
			linux,code = <BTN_MODE>;
		};
		switch-headphone {
			label = "Headphones";
			gpios = <&gpio_l 15 GPIO_ACTIVE_LOW>;
			linux,input-type = <EV_SW>;
			linux,code = <SW_HEADPHONE_INSERT>;
		};
	};

	/*
	 * All buttons and switches, scanned by the second core. reg = bit of
	 * its input state: 0-15 shift register, 32 + n
	 * GPIO L<n>, active low.
	 */
	syscore-buttons {
		compatible = "hichip,gb350-syscore-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&syscore_button_pins>;
		#address-cells = <1>;
		#size-cells = <0>;

		button@0 { reg = <0>; label = "L1"; linux,code = <BTN_TL>; };
		button@1 { reg = <1>; label = "X"; linux,code = <BTN_NORTH>; };
		button@2 { reg = <2>; label = "Y"; linux,code = <BTN_WEST>; };
		button@3 { reg = <3>; label = "R1"; linux,code = <BTN_TR>; };
		button@4 { reg = <4>; label = "B"; linux,code = <BTN_SOUTH>; };
		button@5 { reg = <5>; label = "A"; linux,code = <BTN_EAST>; };
		button@6 { reg = <6>; label = "Select"; linux,code = <BTN_SELECT>; };
		button@7 { reg = <7>; label = "Start"; linux,code = <BTN_START>; };
		button@8 { reg = <8>; label = "Up"; linux,code = <BTN_DPAD_UP>; };
		button@9 { reg = <9>; label = "Down"; linux,code = <BTN_DPAD_DOWN>; };
		button@a { reg = <10>; label = "Left"; linux,code = <BTN_DPAD_LEFT>; };
		button@b { reg = <11>; label = "Right"; linux,code = <BTN_DPAD_RIGHT>; };
		/* L2 per the bootloader DT /panel key-fn (no such button found). */
		button@22 { reg = <34>; label = "Fn"; linux,code = <BTN_MODE>; };
		/* L7/L11: L2/R2 by button test (bootloader DT names swapped). */
		button@27 { reg = <39>; label = "L2"; linux,code = <BTN_TL2>; };
		button@2b { reg = <43>; label = "R2"; linux,code = <BTN_TR2>; };
		button@2c { reg = <44>; label = "Volume Down"; linux,code = <KEY_VOLUMEDOWN>; };
		button@2d { reg = <45>; label = "Volume Up"; linux,code = <KEY_VOLUMEUP>; };
		button@2e { reg = <46>; label = "Power"; linux,code = <KEY_POWER>; };
		switch@2f {
			reg = <47>;
			label = "Headphones";
			linux,input-type = <EV_SW>;
			linux,code = <SW_HEADPHONE_INSERT>;
		};
	};

	/* /panel adc-bat-level = ADC ch1, adc-bat-charging = ADC ch5. */
	battery {
		compatible = "hichip,gb350-battery";
		io-channels = <&adc 1>, <&adc 5>;
		io-channel-names = "battery", "charger";
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/*
		 * GMA layer descriptor (hc16xx-gma, GMA_DESC_PHYS): read by the
		 * display engine, so it must survive a kexec into the next
		 * kernel. Memory above Linux RAM is not safe (pixels appeared
		 * over 0x0afbe000 at runtime).
		 */
		gma_desc: gma-descriptor@af90000 {
			reg = <0x0af90000 0x1000>;
			no-map;
		};

		/*
		 * Boot framebuffer (simple-framebuffer, until the KMS driver
		 * takes over) and the bootloader's layer descriptor inside its
		 * header page (0x0af92a80, copied by hc16xx-gma at
		 * core_initcall): must not be touched before that, also after
		 * a kexec.
		 */
		boot-framebuffer@af91000 {
			reg = <0x0af91000 0x12e000>;
			no-map;
		};

		/*
		 * Second core (avp/syscore): shared memory at 0x0bd00000, its
		 * image, data and stack 0x0bda4000..0x0bf00000.
		 */
		syscore-memory@bd00000 {
			reg = <0x0bd00000 0x200000>;
			no-map;
		};
	};

	chosen {
		/*
		 * Boot randomness (credited by the kernel). Placeholder: the
		 * build replaces these bytes with random ones, the agent
		 * refreshes them on the card at every boot (rngseed.rs).
		 */
		rng-seed = "GB350-RNG-SEED-PLACEHOLDER-32B!";
		/*
		 * loglevel=1: only emergencies reach the screen, so the boot
		 * logo stays up (fbcon takes the screen over only when there
		 * is something to show; a panic or oops raises the level
		 * itself). The full log is in dmesg / the agent's saved logs.
		 */
		bootargs = "console=tty0 loglevel=1 printk.devkmsg=on cgroup_disable=memory firmware_class.path=/mnt/sdcard/gb350/firmware";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/*
		 * Boot framebuffer left running by the bootloader/AVP: 640x480,
		 * 1:1 (hcrtos boot-fb0), header at 0x0af91e50, pixels at
		 * 0x0af93000 (reserved-memory boot-framebuffer; the bootloader's
		 * layer descriptor says so on every cold and watchdog boot).
		 */
		framebuffer@af93000 {
			compatible = "simple-framebuffer";
			reg = <0x0af93000 0x12c000>;
			width = <640>;
			height = <480>;
			stride = <2560>;
			format = "a8r8g8b8";
		};
	};

	/*
	 * Display engine graphics layers (vendor fb0/fb1 use the same block):
	 * KMS driver hc16xx-drm. "hichip,hc16xx-gma" is what the early boot
	 * framebuffer takeover (hc16xx-gma) looks for. Descriptors live in the
	 * reserved page. Panel timing: stock DT /hcrtos/de-engine (917 x 594
	 * total, 60 Hz); the bootloader programs it, this only describes it.
	 */
	display-controller@1883a000 {
		compatible = "hichip,hc16xx-display", "hichip,hc16xx-gma";
		/*
		 * Display engine; then, optional: the 2D engine (rotate/copy
		 * ioctl), the DSI host (panel on/off commands) and the system
		 * controller (2D engine clock gate, reset, clock select).
		 */
		reg = <0x1883a000 0x1000>, <0x18806000 0x1000>, <0x1884a000 0x100>,
		      <0x18800000 0x100>;
		interrupt-parent = <0x03>;
		interrupts = <40>;	/* display engine +0x04 */
		memory-region = <&gma_desc>;
		width-mm = <71>;	/* 3.5" 4:3 */
		height-mm = <53>;

		/*
		 * The panel as the bootloader drives it: 917 x 594 totals at
		 * 33 MHz = 60.58 Hz, measured (display interrupts and flip
		 * timestamps). (32.682 MHz here, a nominal 60.00 Hz, made the
		 * emulators' display pacing run 1% ahead of their sound.)
		 */
		panel-timing {
			clock-frequency = <33000000>;
			hactive = <640>;
			vactive = <480>;
			hfront-porch = <207>;
			hsync-len = <20>;
			hback-porch = <50>;
			vfront-porch = <50>;
			vsync-len = <31>;
			vback-porch = <33>;
			hsync-active = <0>;
			vsync-active = <0>;
			de-active = <1>;
		};
	};

	backlight {
		compatible = "pwm-backlight";
		pwms = <&pwm 0 10000 0>;	/* 100 kHz, as the bootloader */
		pinctrl-names = "default";
		pinctrl-0 = <&backlight_pins>;
		brightness-levels = <0 255>;
		num-interpolated-steps = <255>;
		default-brightness-level = <153>;	/* stock default */
	};

	/*
	 * Audio out: I2S output DMA of the SND0 block into a
	 * CS4344 DAC, left-justified. Second reg: system control (clock gate,
	 * reset, audio PLL and dividers), shared. Speaker amplifier mute (L19)
	 * is driven by the second core.
	 */
	audio@1880a000 {
		compatible = "hichip,hc16xx-i2so";
		reg = <0x1880a000 0x1000>, <0x18800000 0x500>;
		interrupt-parent = <0x03>;
		interrupts = <5>;
		pinctrl-names = "default";
		pinctrl-0 = <&i2s_pins>;
	};

	usb_nop_phy: usb-phy {
		compatible = "usb-nop-xceiv";
		#phy-cells = <0>;
	};

	cpu_ref_clk: clock-cpu {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <1188000000>;
	};

	board {
		label = "hc1600a@dbE3100v20";
	};

	aliases {
		serial0 = "/soc/hc_uart@18818600";
	};

	persistentmem {
		compatible = "hichip,persistentmem";
		mtdname = "persistentmem";
		size = <0x8000>;
	};

	mipi {
		compatible = "hichip,avp-proxy";
		devname = "mipi";
	};

	panel {
		key-do = <0x09>;
		key-clk = <0x08>;
		key-tl1 = <0x0b>;
		key-tr1 = <0x07>;
		lcd-type = <0x04>;
		key-shoulder-left = <0x0b>;
		key-shoulder-right = <0x07>;
		key-volume-down = <0x0c>;
		key-volume-up = <0x0d>;
		headphone-detect = <0x0f>;
		speaker-output = <0x13>;
		lcd-reset-pin = <0x06>;
		power-button = <0x0e>;
		power-pin = <0x01>;
		sdio-det = <0x6d>;
		adc-bat-level = "/dev/check_adc1";
		adc-bat-charging = "/dev/check_adc5";
		status = "okay";
	};

	Unplug_card_display {
		status = "okay";
	};
};
