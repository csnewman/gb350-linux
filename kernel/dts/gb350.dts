			gpio-groups {
				#address-cells = <0x01>;
				#size-cells = <0x01>;

				GPIO_L@gpio-group1 {
					pins = <0x00 0x01 0x02 0x03 0x04 0x05 0x06 0x07 0x08 0x09 0x0a 0x0b 0x0c 0x0d 0x0e 0x0f 0x10 0x11 0x12 0x13 0x14 0x15 0x16 0x17 0x18 0x19 0x1a 0x1b 0x1c 0x1d 0x1e 0x1f>;
					reg = <0x188004a0 0x30>;
				};

				GPIO_B@gpio-group2 {
					pins = <0x20 0x21 0x22 0x23 0x24 0x25 0x26 0x27 0x28 0x29 0x2a 0x2b 0x2c 0x2d 0x2e 0x2f 0x30 0x31 0x32 0x33 0x34 0x35 0x36 0x37 0x38 0x39 0x3a 0x3b 0x3c 0x3d 0x3e 0x3f>;
					reg = <0x188004e0 0x30>;
				};

				GPIO_R@gpio-group3 {
					pins = <0x40 0x41 0x42 0x43 0x44 0x45 0x46 0x47 0x48 0x49 0x4a 0x4b 0x4c 0x4d 0x4e 0x4f 0x50 0x51 0x52 0x53 0x54 0x55 0x56 0x57 0x58 0x59 0x5a 0x5b 0x5c 0x5d 0x5e 0x5f>;
					reg = <0x18800520 0x30>;
				};

				GPIO_T@gpio-group4 {
					pins = <0x60 0x61 0x62 0x63 0x64 0x65 0x66 0x67 0x68 0x69 0x6a 0x6b 0x6c 0x6d 0x6e 0x6f 0x70 0x71 0x72 0x73 0x74 0x75 0x76 0x77 0x78 0x79 0x7a 0x7b 0x7c 0x7d 0x7e 0x7f>;
					reg = <0x18800560 0x30>;
				};
			};

			functions {

				pctl_sf {
					groups = "GPIO_T_14", "GPIO_T_15", "GPIO_T_16", "GPIO_T_17", "GPIO_T_18", "GPIO_T_19";
					field-value-0 = <0x01>;
					field-value-1 = <0x01>;
					field-value-2 = <0x01>;
					field-value-3 = <0x01>;
					field-value-4 = <0x01>;
					field-value-5 = <0x01>;
					linux,phandle = <0x0d>;
					phandle = <0x0d>;
				};

				pctl_spim {
					groups = "GPIO_B_12", "GPIO_B_13", "GPIO_B_15", "GPIO_B_16", "GPIO_B_17";
					field-value-0 = <0x0a>;
					field-value-1 = <0x0a>;
					field-value-2 = <0x0a>;
					field-value-3 = <0x0a>;
					field-value-4 = <0x00>;
				};

				pctl_irc {
					groups = "GPIO_L_14";
					field-value-0 = <0x01>;
					linux,phandle = <0x10>;
					phandle = <0x10>;
				};

				pctl_sdio {
					groups = "GPIO_T_00", "GPIO_T_01", "GPIO_T_02", "GPIO_T_03", "GPIO_T_04", "GPIO_T_05";
					field-value-0 = <0xf9>;
					field-value-1 = <0xf9>;
					field-value-2 = <0xf9>;
					field-value-3 = <0xf9>;
					field-value-4 = <0xf9>;
					field-value-5 = <0xf9>;
					field-value-6 = <0xf9>;
					linux,phandle = <0x0f>;
					phandle = <0x0f>;
				};

				pctl_i2c0 {
					groups = "GPIO_L_12", "GPIO_L_13";
					field-value-0 = <0x05>;
					field-value-1 = <0x05>;
				};
			};
		};

		gpio_l: gpio@18800044 {
			compatible = "hichip,hc16xx-gpio";
			reg = <0x18800044 0x1c>;
			interrupts = <0x00>;
			gpio-controller;
			#gpio-cells = <0x02>;
			ngpio = <0x20>;
			gpio-base = <0x00>;
			interrupt-parent = <0x03>;
			interrupt-controller;
			gpio-ranges = <&pinmux 0 0 32>;
			hwlocks = <&syscore 0>;	/* L8/L9/L1 driven by the second core too */
			#interrupt-cells = <2>;
		};

		gpio_b: gpio@188000c4 {
			compatible = "hichip,hc16xx-gpio";
			reg = <0x188000c4 0x1c>;
			interrupts = <0x00>;
			gpio-controller;
			#gpio-cells = <0x02>;
			ngpio = <0x20>;
			gpio-base = <0x20>;
			interrupt-parent = <0x03>;
			interrupt-controller;
			gpio-ranges = <&pinmux 0 64 32>;
			#interrupt-cells = <2>;
		};

		gpio_r: gpio@188000e4 {
			compatible = "hichip,hc16xx-gpio";
			reg = <0x188000e4 0x1c>;
			interrupts = <0x00>;
			gpio-controller;
			#gpio-cells = <0x02>;
			ngpio = <0x20>;
			gpio-base = <0x40>;
			interrupt-parent = <0x03>;
			interrupt-controller;
			gpio-ranges = <&pinmux 0 128 32>;
			#interrupt-cells = <2>;
		};

		gpio_t: gpio@18800344 {
			compatible = "hichip,hc16xx-gpio";
			reg = <0x18800344 0x1c>;
			interrupts = <0x00>;
			gpio-controller;
			#gpio-cells = <0x02>;
			ngpio = <0x20>;
			gpio-base = <0x60>;
			interrupt-parent = <0x03>;
			interrupt-controller;
			gpio-ranges = <&pinmux 0 192 32>;
			#interrupt-cells = <2>;
		};

		lvds@0xb8860000 {
			compatible = "hichip,lvds,rgb";
			reg = <0x18860000 0x200 0x18800000 0x500>;
			status = "disabled";
		};

		dsc@0x18870000 {
			compatible = "hichip,dsc";
			reg = <0x18834000 0x1000>;
			memory-cache-node = <0x00>;
			interrupts = <0x2c>;
			status = "okay";
		};

		backlight@0 {
			compatible = "pwm-backlight";
			status = "disabled";	/* empty vendor node; see /backlight */
		};
	};

	hcrtos {
		#address-cells = <0x01>;
		#size-cells = <0x01>;

		memory-mapping {
			#address-cells = <0x01>;
			#size-cells = <0x01>;

			bootmem {
				reg = <0x9da0000 0x2000000>;
			};

			sysmem {
				reg = <0xbda2e50 0xb53600>;
			};

			mmz0 {
				id = <0x00>;
				reg = <0xcda2e50 0x325d1b0>;
				blocklog = <0x0c>;
			};

			mmz1 {
				id = <0x01>;
				reg = <0xc8f6450 0x4aca00>;
				blocklog = <0x0c>;
				mmzname = "kshm";
			};
		};

		board {
			label = "hc1600a@dbE3100v20";
		};

		strappin_avp {
			device_type = "hichip,hcrtos-setup-setbit";
			reg_bit = <0xb8800094 0x12 0x01>;
		};

		scpu {
			clock = <0x07>;
			scpu-dig-pll-clk = <0x320>;
		};

		mcpu {
			clock = <0x05>;
			mcpu-dig-pll-clk = <0x4b0>;
		};

		standby {
			ir = <0x1c>;
		};

		hdmi {
			tx_source = <0x01>;
			i2c-devpath = "/dev/i2c0";
			pinmux-hotplug = <0x10 0x01>;
			default-off = <0x01>;
			status = "okay";
		};

		hdmi_rx {
			pinmux-hotplugin = <0x74 0x00>;
			pinmux-detect = <0x74 0x03>;
			pinmux-i2c = <0x76 0x08 0x77 0x08>;
			status = "disabled";
		};

		rotate {
			rotate = <0x00>;
			flip_support = <0x01>;
			h_flip = <0x00>;
			v_flip = <0x00>;
			status = "okay";
		};

		video-engine {
			clock = <0x05>;
			ve-dig-pll-clk = <0x1f4>;
			dynamic-resolution-support = <0x00>;
			video-in-support = <0x00>;
			mm-fb-size = <0x10cf200>;
			mm-vbv-size = <0x00>;
			mm-mf-size = <0x198c00>;
			mm-vin-fb-size = <0xff0000>;
			avc-extra-fb-num = <0x03>;
			avc-mb-nei-size = <0xf000>;
			avc-cmd-queue-size = <0x10000>;
			avc-vbv-size = <0x00>;
			avc-mem-size = <0x31fc000>;
			status = "okay";
		};

		de-engine {
			de4k-clock = <0x06>;
			de-dig-pll-clk = <0x190>;
			dual-output = <0x00>;
			mm-vc-fb-size = <0x19e000>;
			de4k-output = <0x01>;
			cvbs-output = <0x00>;
			vga-output = <0x00>;
			tvtype = <0x0f>;
			pinmux-vga-hsync = <0x0c 0x06>;
			pinmux-vga-vsync = <0x0d 0x06>;
			vga-rgb-dac-r = <0x04>;
			vga-rgb-dac-g = <0x02>;
			vga-rgb-dac-b = <0x01>;
			status = "okay";

			VPInitInfo {

				rgb-cfg {
					b-rgb-enable = <0x01>;
					rgb-mode = <0x00>;
					prgb-mode = <0x00>;
					lcd-width = <0x280>;

					timing-para {
						b-enable = <0x01>;
						h-display_len = <0x00>;
						v-display_len = <0x00>;
						output-clock = <0x02>;
						h-total-len = <0x395>;
						v-total-len = <0x252>;
						h-active-len = <0x280>;
						v-active-len = <0x1e0>;
						h-front-len = <0xcf>;
						h-sync-len = <0x14>;
						h-back-len = <0x32>;
						v-front-len = <0x32>;
						v-sync-len = <0x1f>;
						v-back-len = <0x21>;
						h-sync-level = <0x00>;
						v-sync-level = <0x00>;
						active-polarity = <0x01>;
						frame-rate = <0xea60>;
						dpll-clock-reg-value = <0x00>;
					};
				};
			};
		};

		boot-fb0 {
			bits_per_pixel = <0x20>;
			xres = <0x280>;
			yres = <0x1e0>;
			xres_virtual = <0x280>;
			yres_virtual = <0x1e0>;
			xoffset = <0x00>;
			yoffset = <0x00>;
			scale = <0x280 0x1e0 0x280 0x1e0>;
			reg = <0x1883a000 0x1000>;
			buffer-source = "static";
			extra-buffer-size = <0x00>;
			buffer-phy-static = <0xaf91e50 0xe11000>;
			buffer-header-size = <0x1000>;
			use-static-header;
			status = "okay";
		};

		i2c@0 {
			pinmux-active = <0x11 0x01 0x12 0x01>;
			devpath = "/dev/i2c0";
			baudrate = <0x1c200>;
			mode = "master";
			status = "okay";
		};

		uart@2 {
			devpath = "/dev/uart2";
			status = "disabled";
		};

		uart@3 {
			devpath = "/dev/uart3";
			status = "disabled";
		};

		uart_dummy {
			devpath = "/dev/uart_dummy";
			status = "okay";
		};

		virtuart {
			devpath = "/dev/virtuart";
			status = "okay";
		};

		stdio {
			serial0 = "/hcrtos/virtuart";
		};

		boot-stdio {
			serial0 = "/hcrtos/uart_dummy";
		};

		i2s {
			pinmux-clock = <0x03 0x02 0x04 0x02>;
			status = "okay";
			format = "lj";
			ejtag = "disabled";
		};

		cs4344 {
			status = "okay";
		};

		wm8960 {
			status = "disabled";
		};

		cjc8990 {
			status = "disabled";
			i2c-devpath = "/dev/i2c1";
		};

		i2so {
			pinmux-data = <0x05 0x02>;
			speed_fade = <0x05>;
			mute-polar = <0x00>;
			volume = <0xff>;
			status = "okay";
		};

		i2si {
			pinmux-data = <0x01 0x02>;
			volume = <0xff>;
			status = "okay";
		};

		i2si0 {
			status = "disabled";
		};

		i2si1 {
			status = "disabled";
		};

		i2si2 {
			status = "disabled";
		};

		spdif-out {
			status = "disabled";
		};

		spdif-in {
			status = "disabled";
		};

		pcmi {
			status = "disabled";
		};

		pcmi0 {
			status = "disabled";
		};

		pcmi1 {
			status = "disabled";
		};

		pcmi2 {
			status = "disabled";
		};

		pcmo {
			status = "disabled";
		};

		tdmi {
			status = "disabled";
		};

		pdmi0 {
			status = "disabled";
		};

		pdmi1 {
			status = "disabled";
		};

		pdmi2 {
			status = "disabled";
		};

		usb0 {
			reg = <0x18844000 0x1000>;
			interrupts = <0x35 0x34>;
			interrupt-names = "mc", "dma";
			dr_mode = "host";
			index_num = <0x00>;
			ctrl_base = <0x18800000>;
			status = "okay";
		};

		usb1 {
			reg = <0x18850000 0x1000>;
			interrupts = <0x33 0x32>;
			interrupt-names = "mc", "dma";
			dr_mode = "host";
			index_num = <0x01>;
			ctrl_base = <0x18800000>;
			status = "okay";
		};

		persistentmem {
			mtdname = "persistentmem";
			size = <0x8000>;
			status = "okay";
		};

		sfspi {
			pinmux-active = <0x6e 0x01 0x6f 0x01 0x70 0x01 0x71 0x01 0x72 0x01 0x73 0x01>;
			sclk = <0x2faf080>;
			dma-mode = <0x01>;
			status = "okay";

			spi_nor_flash {
				spi-tx-bus-width = <0x01>;
				spi-rx-bus-width = <0x01>;
				reg = <0x00>;
				status = "okay";

				partitions {
					part-num = <0x03>;
					part1-label = "boot";
					part1-reg = <0x00 0x6c000>;
					part1-filename = "bootloader.bin";
					part2-label = "eromfs";
					part2-reg = <0x6c000 0x4000>;
					part2-filename = "romfs.img";
					part3-label = "persistentmem";
					part3-reg = <0x70000 0x10000>;
					part3-filename = "persistentmem.bin";
				};
			};

			spidev@0 {
				devpath = "/dev/spidev0";
				reg = <0x00>;
				spi-max-frequency = <0x2faf080>;
				status = "okay";
			};
		};

		external_files {
			part-num = <0x04>;
			path-prefix = "cubegm";
			part1-label = "dtb";
			part1-filename = "dtb.bin";
			part2-label = "avp";
			part2-filename = "avp.uImage";
			part3-label = "linux";
			part3-filename = "vmlinux.uImage";
			part4-label = "logo";
			part4-filename = "xgame-logo.bmp";
		};

		mmc {
			hcrtos-compatible = "hichip,dw-mshc";
			reg = <0x1884c000 0x2000>;
			card-detect-delay = <0xc8>;
			clock-frequency = <0xbcd3d80>;
			clock-freq-min-max = <0x186a0 0x1312d00>;
			interrupts = <0x0a>;
			pinmux-active = <0x60 0xf9 0x61 0xf9 0x62 0xf9 0x63 0xf9 0x64 0xf9 0x65 0xf9>;
			status = "okay";
			bus-width = <0x04>;
			broken-cd;
			cap-sd-highspeed;
			sd-uhs-sdr12;
			sd-uhs-sdr25;
		};

		pwm@0 {
			pinmux-active = <0x00 0x04>;
			devpath = "/dev/pwm0";
			status = "okay";
		};

		queryadc0 {
