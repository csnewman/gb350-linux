		gpio-out-def {
			status = "okay";
			gpio-group = <0x08 0x00 0x09 0x00 0x06 0x00>;
		};

		dsi0 {
			lcd-reset-gpios-rtos = <0x06 0x01>;
			init-delay-ms = <0x14>;
			reset-delay-ms = <0x14>;
			enable-delay-ms = <0x0a>;
			prepare-delay-ms = <0x0a>;
			status = "okay";
			reg = <0x1884a000 0x300 0x18800444 0x08 0x18800080 0x08>;
			dsi,format = <0x05>;
			dsi,lanes = <0x04>;
			dsi,cfg = <0x1c>;
			dsi,flags = <0x3fd>;
			mipi-drive-strength = <0x02>;
			dsi,swap = <0x00>;
			src-sel = <0x01>;
			clock-frequency = <0x00>;
			h-sync-level = <0x00>;
			v-sync-level = <0x00>;
			panel-init-sequence = <0x150002ff 0x30150002 0xff521500 0x2ff0115 0x2e300 0x15000225 0x10150002 0x286f1500 0x2290115 0x22adf 0x1500022c 0x22150002 0xc30f1500 0x2379c15 0x238a7 0x15000239 0x41150002 0x80201500 0x2916715 0x29267 0x150002a0 0x55150002 0xa1501500 0x2a35815 0x2a49c 0x150002a7 0x2150002 0xa8011500 0x2a92115 0x2aafc 0x150002ab 0x28150002 0xac061500 0x2ad0615 0x2ae06 0x150002af 0x3150002 0xb0081500 0x2b12615 0x2b228 0x150002b3 0x28150002 0xb4031500 0x2b50815 0x2b626 0x150002b7 0x8150002 0xb8261500 0x2c00015 0x2c100 0x150002c2 0x150002 0xff301500 0x2ff5215 0x2ff02 0x150002b0 0x2150002 0xd0021500 0x2b10f15 0x2d110 0x150002b2 0x11150002 0xd2121500 0x2b33215 0x2d333 0x150002b4 0x36150002 0xd4361500 0x2b53c15 0x2d53c 0x150002b6 0x20150002 0xd6201500 0x2b73e15 0x2d73e 0x150002b8 0xe150002 0xd80d1500 0x2b90515 0x2d905 0x150002ba 0x11150002 0xda121500 0x2bb1115 0x2db11 0x150002bc 0x13150002 0xdc141500 0x2bd1415 0x2dd14 0x150002be 0x16150002 0xde181500 0x2bf0e15 0x2df0f 0x150002c0 0x17150002 0xe0171500 0x2c10715 0x2e108 0x150002ff 0x30150002 0xff521500 0x2ff0315 0x2088a 0x15000209 0x8b150002 0x30001500 0x2310015 0x23200 0x15000233 0x150002 0x34611500 0x235d415 0x23624 0x15000237 0x3150002 0x40861500 0x2418715 0x24284 0x15000243 0x85150002 0x44111500 0x245de15 0x246dd 0x15000247 0x11150002 0x48e01500 0x249df15 0x25082 0x15000251 0x83150002 0x52801500 0x2538115 0x25411 0x15000255 0xe2150002 0x56e11500 0x2571115 0x258e4 0x15000259 0xe3150002 0x820f1500 0x2830f15 0x28400 0x15000285 0xf150002 0x860f1500 0x2870e15 0x2880e 0x15000289 0x6150002 0x8a061500 0x28b0715 0x28c07 0x1500028d 0x4150002 0x8e041500 0x28f0515 0x29005 0x15000298 0xf150002 0x990f1500 0x29a0015 0x29b0f 0x1500029c 0xf150002 0x9d0e1500 0x29e0e15 0x29f06 0x150002a0 0x6150002 0xa1071500 0x2a20715 0x2a304 0x150002a4 0x4150002 0xa5051500 0x2a60515 0x2e002 0x150002e1 0x52150002 0xff301500 0x2ff5215 0x2ff00 0x15000236 0x215c802 0x11001564 0x22900ff 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x