/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>
// SPDX-License-Identifier: GPL-2.0
/*
 * GB350 v1.22 handheld (HiChip HC1600A, MIPS 74Kc) - device tree for mainline Linux.
 *
 * Derived from the stock firmware's dtb.bin.
 * The bootloader passes this same blob to the AVP co-processor, which reads its
 * configuration from /hcrtos (memory map, panel/MIPI, display engine, audio).
 * /hcrtos refers to the fixed clocks by phandle (0x05-0x07), so those nodes keep
 * their explicit phandles. Everything outside /hcrtos is for Linux.
 */

/ {
	model = "GB350 (HiChip HC1600A)";
	compatible = "hichip,gb350", "hichip,hc1600";
	#address-cells = <0x01>;
	#size-cells = <0x01>;
	interrupt-parent = <0x01>;

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "mti,mips74Kc";
			reg = <0x00>;
			clocks = <&cpu_ref_clk>;
			clock = <0x05>;
			mcpu-dig-pll-clk = <0x384>;
		};
	};

	cpuintc@0 {
		#address-cells = <0x00>;
		#interrupt-cells = <0x01>;
		interrupt-controller;
		compatible = "mti,cpu-interrupt-controller";
		linux,phandle = <0x01>;
		phandle = <0x01>;
	};

	soc {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		device_type = "soc";
		ranges;
		compatible = "hichip,hc16xx", "simple-bus";
		interrupt-parent = <0x03>;

		strappin {
			device_type = "hichip,platform-setup-setbit";
			reg_bit = <0x18800094 0x12 0x01>;
		};

		clocks {
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			compatible = "simple-bus";
			ranges;

			f594 {
				#clock-cells = <0x00>;
				compatible = "fixed-clock";
				clock-frequency = <0x2367b880>;
				clock-output-names = "f594";
				linux,phandle = <0x04>;
				phandle = <0x04>;
			};

			f396 {
				#clock-cells = <0x00>;
				compatible = "fixed-clock";
				clock-frequency = <0x179a7b00>;
				clock-output-names = "f396";
				linux,phandle = <0x05>;
				phandle = <0x05>;
			};

			f297 {
				#clock-cells = <0x00>;
				compatible = "fixed-clock";
				clock-frequency = <0x11b3dc40>;
				clock-output-names = "f297";
				linux,phandle = <0x06>;
				phandle = <0x06>;
			};

			f198 {
				#clock-cells = <0x00>;
				compatible = "fixed-clock";
				clock-frequency = <0xbcd3d80>;
				clock-output-names = "f198";
				linux,phandle = <0x07>;
				phandle = <0x07>;
			};

			f900 {
				#clock-cells = <0x00>;
				compatible = "fixed-clock";
				clock-frequency = <0x35a4e900>;
				clock-output-names = "f900";
				linux,phandle = <0x08>;
				phandle = <0x08>;
			};

			f1188 {
				#clock-cells = <0x00>;
				compatible = "fixed-clock";
				clock-frequency = <0x46cf7100>;
				clock-output-names = "f1188";
				linux,phandle = <0x09>;
				phandle = <0x09>;
			};

			f24 {
				#clock-cells = <0x00>;
				compatible = "fixed-clock";
				clock-frequency = <0x16e3600>;
				clock-output-names = "f24";
				linux,phandle = <0x0a>;
				phandle = <0x0a>;
			};

			fdig {
				#clock-cells = <0x00>;
				compatible = "fixed-clock";
				clock-frequency = <0x35a4e900>;
				clock-output-names = "fdig";
				linux,phandle = <0x0b>;
				phandle = <0x0b>;
			};

			base_clk {
				compatible = "hichip,base-clk";
				#address-cells = <0x01>;
				#size-cells = <0x01>;
				ranges;

				cpu_clk@18800070 {
					#clock-cells = <0x00>;
					compatible = "hichip,cpu-clk";
					reg = <0x18800074 0x04 0x18800070 0x04>;
					ctrl_shift = [08];
					info_shift = [08];
					trig_shift = [16];
					width = [03];
					clocks = <0x04 0x05 0x06 0x07 0x08 0x09 0x0a 0x0b>;
					clock-output-names = "cpu_clk";
					linux,phandle = <0x02>;
					phandle = <0x02>;
				};
			};

			mmcclk {
				#clock-cells = <0x00>;
				compatible = "fixed-clock";
				clock-frequency = <0xbcd3d80>;
				linux,phandle = <0x0e>;
				phandle = <0x0e>;
			};
		};

		intc@0x18800000 {
			compatible = "hichip,hc16xx-intc";
			interrupt-controller;
			#interrupt-cells = <0x01>;
			interrupt-parent = <0x01>;
			interrupts = <0x03 0x02>;
			/* status, enable, summary (see irq-hc16xx.c) */
			reg = <0x18800030 0x08 0x18800038 0x0c 0x18800020 0x04>;
			linux,phandle = <0x03>;
			phandle = <0x03>;
		};

		timer@0x18818a00 {
			compatible = "hichip,south-bridge-timer";
			reg = <0x18818a00 0x100>;
			interrupts = <0x16>;
			clock-frequency = <0x16e3600>;
		};

		uart@18818300 {
			compatible = "ns16550a";
			reg = <0x18818300 0x0c>;
			interrupts = <0x10>;
			clock-frequency = <0x1c2000>;
			current-speed = <0x1c200>;
			reg-offset = <0x00>;
			reg-shift = <0x00>;
			fifo-size = <0x10>;
			reg-io-width = <0x01>;
			device_type = "hichip,platform-setup-setbit";
			reg_bit = <0x18800060 0x10 0x00 0x18800094 0x12 0x01>;
			status = "disabled";	/* clock gated under mainline (0x60 bit 16) */
		};

		uart@18818600 {
			compatible = "ns16550a";
			reg = <0x18818600 0x0c>;
			interrupts = <0x11>;
			clock-frequency = <0x1c2000>;
			current-speed = <0x1c200>;
			reg-offset = <0x00>;
			reg-shift = <0x00>;
			fifo-size = <0x10>;
			reg-io-width = <0x01>;
			device_type = "hichip,platform-setup-setbit";
			reg_bit = <0x18800060 0x11 0x00>;
		};

		uart@18818800 {
			compatible = "ns16550a";
			reg = <0x18818800 0x0c>;
			interrupts = <0x36>;
			clock-frequency = <0x1c2000>;
			current-speed = <0x1c200>;
			reg-offset = <0x00>;
			reg-shift = <0x00>;
			fifo-size = <0x10>;
			reg-io-width = <0x01>;
			device_type = "hichip,platform-setup-setbit";
			reg_bit = <0x18800064 0x0b 0x00>;
			status = "disabled";
		};

		uart@18818900 {
			compatible = "ns16550a";
			reg = <0x18818900 0x0c>;
			interrupts = <0x37>;
			clock-frequency = <0x1c2000>;
			current-speed = <0x1c200>;
			reg-offset = <0x00>;
			reg-shift = <0x00>;
			fifo-size = <0x10>;
			reg-io-width = <0x01>;
			device_type = "hichip,platform-setup-setbit";
			reg_bit = <0x18800064 0x0b 0x00>;
			status = "disabled";
		};

		hc_uart@18818300 {
			compatible = "hichip,hc_uart";
			reg = <0x18818300 0x0c>;
			interrupts = <0x10>;
			device_type = "hichip,platform-setup-setbit";
			reg_bit = <0x18800060 0x11 0x00>;
			status = "disabled";
		};

		hc_uart@18818600 {
			compatible = "hichip,hc_uart";
			reg = <0x18818600 0x0c>;
			interrupts = <0x11>;
			device_type = "hichip,platform-setup-setbit";
			reg_bit = <0x18800060 0x11 0x00>;
			status = "disabled";
		};

		hc_uart@18818800 {
			compatible = "hichip,hc_uart";
			reg = <0x18818800 0x0c>;
			interrupts = <0x36>;
			device_type = "hichip,platform-setup-setbit";
			reg_bit = <0x18800064 0x0b 0x00>;
			status = "disabled";
		};

		hc_uart@18818900 {
			compatible = "hichip,hc_uart";
			reg = <0x18818900 0x0c>;
			interrupts = <0x37>;
			device_type = "hichip,platform-setup-setbit";
			reg_bit = <0x18800064 0x0b 0x00>;
			status = "disabled";
		};

		i2c@18818200 {
			compatible = "hichip,hc_i2c";
			reg = <0x18818200 0x100>;
			master-mode = <0x01>;
			baud_speed = <0x186a0>;
			interrupts = <0x12>;
			status = "disabled";
		};

		i2c@18818700 {
			compatible = "hichip,hc_i2c";
			reg = <0x18818700 0x100>;
			master-mode = <0x01>;
			baud_speed = <0x186a0>;
			interrupts = <0x19>;
			status = "disabled";
		};

		i2c@18818b00 {
			compatible = "hichip,hc_i2c";
			reg = <0x18818b00 0x100>;
			master-mode = <0x01>;
			baud_speed = <0x186a0>;
			interrupts = <0x1a>;
			status = "disabled";
		};

		i2c@18818c00 {
			compatible = "hichip,hc_i2c";
			reg = <0x18818c00 0x100>;
			master-mode = <0x01>;
			baud_speed = <0x186a0>;
			interrupts = <0x2b>;
			status = "disabled";
		};

		amprpc@18089410 {
			compatible = "hichip,amprpc";
			interrupts = <0x42>;
			reg = <0x18800800 0x20 0x18800820 0x20 0x18800840 0x20 0x18800860 0x20 0x18800880 0x20 0x188008a0 0x20 0x188008c0 0x20 0x188008e0 0x20 0x18866800 0x20 0x18866820 0x20 0x18866840 0x20 0x18866860 0x20 0x18866880 0x20 0x188668a0 0x20 0x188668c0 0x20 0x188668e0 0x20>;
		};

		hwspinlock@0x18867000 {
			compatible = "hichip,hwspinlock";
			reg = <0x18867000 0x04>;
		};

		virtuart {
			compatible = "hichip,virtuart";
		};

		linux-efuse {
			compatible = "hichip,efuse";
		};

		soc-16xx {
			compatible = "hichip, soc-16xx";
		};

		playback-platform {
			compatible = "hichip, playback-platform";
			interrupts = <0x05>;
		};

		playback-codec@0 {
			compatible = "hichip, playback-codec";
		};

		kshmdev {
			compatible = "hichip,kshmdev";
		};

		mmz {
			compatible = "hichip,mmz";
		};

		auddec {
			compatible = "hichip,avp-proxy";
			devname = "auddec";
		};

		audsink {
			compatible = "hichip,avp-proxy";
			devname = "audsink";
		};

		viddec {
			compatible = "hichip,avp-proxy";
			devname = "viddec";
		};

		avsync0 {
			compatible = "hichip,avp-proxy";
			devname = "avsync0";
		};

		vindvp {
			compatible = "hichip,avp-proxy";
			devname = "vindvp";
		};

		i2so {
			compatible = "hichip,avp-proxy";
			devname = "sndC0i2so";
		};

		i2si {
			compatible = "hichip,avp-proxy";
			devname = "sndC0i2si";
		};

		spdif-out {
			compatible = "hichip,avp-proxy";
			devname = "sndC0spo";
		};

		vidsink {
			compatible = "hichip,avp-proxy";
			devname = "vidsink";
		};

		dis {
			compatible = "hichip,avp-proxy";
			devname = "dis";
		};

		tv_decoder {
			compatible = "hichip,avp-proxy";
			devname = "tv_decoder";
		};

		pq {
			compatible = "hichip,avp-proxy";
			devname = "pq";
		};

		hdmi_rx {
			compatible = "hichip,avp-proxy";
			devname = "hdmi_rx";
		};

		hdmi_tx {
			compatible = "hichip,avp-proxy";
			devname = "hdmi";
		};

		standby {
			compatible = "hichip,avp-proxy";
			devname = "standby";
		};

		ZZd2C {
			compatible = "hichip,avp-proxy";
			devname = "ZZd2C";
		};

		backlight {
			compatible = "hichip,avp-proxy";
			devname = "backlight";
		};

		watchdog@18818500 {
			compatible = "hichip,watchdog";
			reg = <0x18818500 0x0a>;
			interrupts = <0x17>;
			timeout-sec = <0x1e>;
		};

		fb0@18808000 {
			compatible = "hichip,hc16xx-fb";
			bits_per_pixel = <0x20>;
			xres = <0x2d0>;
			yres = <0x500>;
			xres_virtual = <0x2d0>;
			yres_virtual = <0x1400>;
			xoffset = <0x00>;
			yoffset = <0x00>;
			scale = <0x2d0 0x500 0x780 0x438>;
			reg = <0x1883a000 0x1000>;
			buffer-source = "static";
			extra-buffer-size = <0x00>;
			buffer-phy-static = <0xaf91e50 0xe11000>;
			buffer-header-size = <0x1000>;
			use-static-header;
			status = "okay";
			default-on;
		};

		fb1@18808080 {
			compatible = "hichip,hc16xx-fb";
			reg = <0x1883a080 0x1000>;
			bits_per_pixel = <0x20>;
			xres = <0x280>;
			yres = <0x1e0>;
			xres_virtual = <0x280>;
			yres_virtual = <0x1e0>;
			xoffset = <0x00>;
			yoffset = <0x00>;
			scale = <0x280 0x1e0 0x280 0x1e0>;
			buffer-source = "system";
			extra-buffer-size = <0x00>;
			pre-multiply = <0x00>;
			status = "okay";
		};

		ge@18806000 {
			compatible = "hichip,hc16xx-ge";
			reg = <0x18806000 0x2000 0x18800000 0x1000>;
			interrupts = <0x04>;
			cmdq_buf_size = <0x3c000>;
			status = "okay";
		};

		ethernet@18828000 {
			compatible = "hichip,toe";
			device_type = "network";
			model = "HiChip TOE";
			reg = <0x18828000 0x2000 0x18800000 0x04>;
			interrupts = <0x0e>;
			rx-csum-enable = <0x01>;
			tx-csum-enable = <0x01>;
			phy-mode = "rmii";
			phy-reversemii = <0x00>;
			phy-handle = <0x0c>;
			status = "disabled";

			mdio {
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				status = "okay";

				ethernet-phy@1 {
					reg = <0x01>;
					device_type = "ethernet-phy";
					linux,phandle = <0x0c>;
					phandle = <0x0c>;
				};
			};
		};

		spi@1882e000 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			compatible = "hichip,hc16xx-spi-sf";
			reg = <0x1882e000 0xe0 0x1f000000 0x1000 0x1f000000 0x1000>;
			num-cs = <0x02>;
			interrupts = <0x23>;
			sclk = <0x2faf080>;
			dma-mode = <0x01>;
			pinctrl-names = "active";
			pinctrl-0 = <0x0d>;

			spi_flash@0 {
				#address-cells = <0x01>;
				#size-cells = <0x01>;
				compatible = "m25p80";
				reg = <0x00>;
				spi-max-frequency = <0x5f5e100>;
				spi-tx-bus-width = <0x02>;
				spi-rx-bus-width = <0x02>;

				partitions {
					compatible = "fixed-partitions";
					#address-cells = <0x01>;
					#size-cells = <0x01>;

					nor {
						label = "nor";
						reg = <0x00 0x80000>;
					};

					boot {
						label = "boot";
						reg = <0x00 0x6c000>;
					};

					eromfs {
						label = "eromfs";
						reg = <0x6c000 0x4000>;
					};

					persistentmem {
						label = "persistentmem";
						reg = <0x70000 0x10000>;
					};
				};
			};

			spidev@0 {
				compatible = "rohm,dh2228fv";
				reg = <0x01>;
				spi-max-frequency = <0x5f5e100>;
			};
		};

		spim@18848000 {
			compatible = "hichip,hc16xx-spi";
			reg = <0x18848000 0x100>;
			clk_ratio = <0x04>;
			transfer-mode = <0x00>;
			dma-mode = <0x01>;
			cs-pin = <0x31>;
			status = "disabled";
		};

		nand@18832000 {
			compatible = "hichip,hc16xx-nfc";
			reg = <0x18832000 0x60>;
			interrupts = <0x30>;
			scrambling = <0x00>;
			nand-on-flash-bbt;
			nand-ecc-mode = "hw";
			nand-ecc-algo = "bch";
			status = "disabled";
		};

		usb@18844000 {
			compatible = "hichip,hc16xx-musb";
			reg = <0x18844000 0x1000>;
			interrupts = <0x35 0x34>;
			interrupt-names = "mc", "dma";
			/* USB-C port: gadget for the agent's control channel (host works too). */
			dr_mode = "peripheral";
			phys = <&usb_nop_phy>;
			index_num = <0x00>;
			ctrl_base = <0x18800000>;
			status = "okay";
		};

		usb@18850000 {
			compatible = "hichip,hc16xx-musb";
			reg = <0x18850000 0x1000>;
			interrupts = <0x33 0x32>;
			interrupt-names = "mc", "dma";
			dr_mode = "host";
			index_num = <0x01>;
			ctrl_base = <0x18800000>;
			status = "disabled";
		};

		mmc@1884C000 {
			/*
			 * Plain DesignWare MSHC. The bootloader has already set the
			 * card clock source (198 MHz), 3.3 V signalling and pin-mux
			 * so no vendor glue is needed.
			 */
			compatible = "snps,dw-mshc";
			reg = <0x1884c000 0x2000>;
			interrupts = <0x0a>;
			clocks = <0x0e 0x0e>;
			clock-names = "biu", "ciu";
			card-detect-delay = <0xc8>;
			bus-width = <0x04>;
			max-frequency = <25000000>;
			cd-gpios = <&gpio_t 13 GPIO_ACTIVE_LOW>;	/* /panel sdio-det */
			cap-sd-highspeed;
			status = "okay";
		};

		irc@18818100 {
			compatible = "hichip,hc16xx-irc";
			reg = <0x18818100 0x60>;
			interrupts = <0x13>;
			linux,rc-map-name = "rc-hcdemo";
			pinctrl-names = "active";
			pinctrl-0 = <0x10>;
			status = "disabled";
		};

		key_adc0@18818400 {
			compatible = "hichip, hc16xx-key-adc";
			reg = <0x18818400 0x100 0x18800160 0x14>;
			interrupts = <0x25>;
			status = "disabled";
		};

		key_adc1@18818400 {
			compatible = "hichip, hc16xx-key-adc";
			reg = <0x18818400 0x100 0x18800160 0x14>;
			interrupts = <0x25>;
			status = "disabled";
		};

		key_adc2@18818400 {
			compatible = "hichip, hc16xx-key-adc";
			reg = <0x18818400 0x100 0x18800160 0x14>;
			interrupts = <0x25>;
			status = "disabled";
		};

		key_adc3@18818400 {
			compatible = "hichip, hc16xx-key-adc";
			reg = <0x18818400 0x100 0x18800160 0x14>;
			interrupts = <0x25>;
			status = "disabled";
			adc_ref_voltage = <0x762>;
			key-map = <0xc8 0x1f4 0x67 0x259 0x352 0x6c 0x353 0x44c 0x69 0x44d 0x514 0x6a 0x515 0x5dc 0x160 0x5dd 0x686 0x8b 0x687 0x6fe 0xae>;
		};

		key_adc4@18818400 {
			compatible = "hichip, hc16xx-key-adc";
			reg = <0x18818400 0x100 0x18800160 0x14>;
			interrupts = <0x25>;
			status = "disabled";
		};

		key_adc5@18818400 {
			compatible = "hichip, hc16xx-key-adc";
			reg = <0x18818400 0x100 0x18800160 0x14>;
			interrupts = <0x25>;
			status = "disabled";
		};

		check_adc0@18818400 {
			compatible = "hichip, hc16xx-check-adc";
			reg = <0x18818400 0x100 0x18800160 0x14>;
			status = "disabled";
		};

		/* SAR ADC for Linux (the check_adc/key_adc nodes are vendor). */
		adc: adc@18818400 {
			compatible = "hichip,hc16xx-adc";
			reg = <0x18818400 0x100>;
			#io-channel-cells = <1>;
		};

		check_adc1@18818400 {
			compatible = "hichip, hc16xx-check-adc";
			reg = <0x18818400 0x100 0x18800160 0x14>;
			status = "okay";
			adjust_channel = <0x00>;
		};

		check_adc2@18818400 {
			compatible = "hichip, hc16xx-check-adc";
			reg = <0x18818400 0x100 0x18800160 0x14>;
			status = "disabled";
		};

		check_adc3@18818400 {
			compatible = "hichip, hc16xx-check-adc";
			reg = <0x18818400 0x100 0x18800160 0x14>;
			status = "disabled";
			adjust_channel = <0x01>;
		};

		check_adc4@18818400 {
			compatible = "hichip, hc16xx-check-adc";
			reg = <0x18818400 0x100 0x18800160 0x14>;
			status = "disabled";
		};

		check_adc5@18818400 {
			compatible = "hichip, hc16xx-check-adc";
			reg = <0x18818400 0x100 0x18800160 0x14>;
			status = "okay";
			adjust_channel = <0x00>;
		};

		gpio-keys {
			compatible = "gpio-keys";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			autorepeat;
			status = "disabled";	/* empty vendor node; see /keys */
		};

		/* Channel 0 = backlight (L0, function 4). */
		pwm: pwm@18818410 {
			compatible = "hichip,hc16xx-pwm";
			reg = <0x18818410 0x24>;
			#pwm-cells = <3>;
		};

		gpio_key_group {
			compatible = "hichip,hc-gpio-key";
			statsu = "disabled";
		};

		/*
		 * Pin-mux for Linux: one byte per pin, function 0 = GPIO. Pin
		 * number = byte offset: L 0-31, B 64-95, R 128-159, T 192-223.
		 * (The vendor node below has no Linux driver; the AVP may read it.)
		 */
		pinmux: pinmux@188004a0 {
			compatible = "pinctrl-single";
			reg = <0x188004a0 0xe0>;
			#pinctrl-cells = <1>;
			#address-cells = <1>;
			#size-cells = <0>;
			pinctrl-single,register-width = <8>;
			pinctrl-single,function-mask = <0xff>;
			pinctrl-single,gpio-range = <&gpio_range 0 32 0>, <&gpio_range 64 32 0>,
						    <&gpio_range 128 32 0>, <&gpio_range 192 32 0>;

			gpio_range: gpio-range {
				#pinctrl-single,gpio-range-cells = <3>;
			};

			/*
			 * Pins the second core drives or reads, set to GPIO
			 * (function 0) and claimed by the syscore nodes. After a
			 * cold boot L15 is on function 1 (reads low).
			 */
			syscore_power_pins: syscore-power-pins {
				pinctrl-single,pins = <1 0 19 0>;	/* L1 power latch, L19 speaker mute */
			};
			i2s_pins: i2s-pins {
				/* L3/L4 clocks, L5 data (stock /hcrtos/i2s, i2so) */
				pinctrl-single,pins = <3 2 4 2 5 2>;
			};
			backlight_pins: backlight-pins {
				pinctrl-single,pins = <0 4>;	/* L0: PWM0 */
			};
			syscore_button_pins: syscore-button-pins {
				pinctrl-single,pins = <2 0 7 0 8 0 9 0 11 0 12 0 13 0 14 0 15 0>;
			};
		};

		pinctrl@0x18800000 {
			compatible = "hichip,pinctrl";
			reg = <0x18800000 0x820>;
			pins = "GPIO_L_00", "GPIO_L_01", "GPIO_L_02", "GPIO_L_03", "GPIO_L_04", "GPIO_L_05", "GPIO_L_06", "GPIO_L_07", "GPIO_L_08", "GPIO_L_09", "GPIO_L_10", "GPIO_L_11", "GPIO_L_12", "GPIO_L_13", "GPIO_L_14", "GPIO_L_15", "GPIO_L_16", "GPIO_L_17", "GPIO_L_18", "GPIO_L_19", "GPIO_L_20", "GPIO_L_21", "GPIO_L_22", "GPIO_L_23", "GPIO_L_24", "GPIO_L_25", "GPIO_L_26", "GPIO_L_27", "GPIO_L_28", "GPIO_L_29", "GPIO_L_30", "GPIO_L_31", "GPIO_B_00", "GPIO_B_01", "GPIO_B_02", "GPIO_B_03", "GPIO_B_04", "GPIO_B_05", "GPIO_B_06", "GPIO_B_07", "GPIO_B_08", "GPIO_B_09", "GPIO_B_10", "GPIO_B_11", "GPIO_B_12", "GPIO_B_13", "GPIO_B_14", "GPIO_B_15", "GPIO_B_16", "GPIO_B_17", "GPIO_B_18", "GPIO_B_19", "GPIO_B_20", "GPIO_B_21", "GPIO_B_22", "GPIO_B_23", "GPIO_B_24", "GPIO_B_25", "GPIO_B_26", "GPIO_B_27", "GPIO_B_28", "GPIO_B_29", "GPIO_B_30", "GPIO_B_31", "GPIO_R_00", "GPIO_R_01", "GPIO_R_02", "GPIO_R_03", "GPIO_R_04", "GPIO_R_05", "GPIO_R_06", "GPIO_R_07", "GPIO_R_08", "GPIO_R_09", "GPIO_R_10", "GPIO_R_11", "GPIO_R_12", "GPIO_R_13", "GPIO_R_14", "GPIO_R_15", "GPIO_R_16", "GPIO_R_17", "GPIO_R_18", "GPIO_R_19", "GPIO_R_20", "GPIO_R_21", "GPIO_R_22", "GPIO_R_23", "GPIO_R_24", "GPIO_R_25", "GPIO_R_26", "GPIO_R_27", "GPIO_R_28", "GPIO_R_29", "GPIO_R_30", "GPIO_R_31", "GPIO_T_00", "GPIO_T_01", "GPIO_T_02", "GPIO_T_03", "GPIO_T_04", "GPIO_T_05", "GPIO_T_06", "GPIO_T_07", "GPIO_T_08", "GPIO_T_09", "GPIO_T_10", "GPIO_T_11", "GPIO_T_12", "GPIO_T_13", "GPIO_T_14", "GPIO_T_15", "GPIO_T_16", "GPIO_T_17", "GPIO_T_18", "GPIO_T_19", "GPIO_T_20", "GPIO_T_21", "GPIO_T_22", "GPIO_T_23", "GPIO_T_24", "GPIO_T_25", "GPIO_T_26", "GPIO_T_27", "GPIO_T_28", "GPIO_T_29", "GPIO_T_30", "GPIO_T_31";
