# GB350 (HiChip HC1600A) kernel config, applied via `make allnoconfig`
# (KCONFIG_ALLCONFIG) so only what is listed here is built in. Keep the
# uncompressed image well under the vendor kernel's 8.7 MB: the bootloader's
# staging area for the compressed image is unknown.

# Platform: generic MIPS (UHI boot: a0=-2, a1=DTB), MIPS32r2 little endian.
CONFIG_MIPS_GENERIC_KERNEL=y
CONFIG_CPU_MIPS32_R2=y
CONFIG_CPU_LITTLE_ENDIAN=y
CONFIG_32BIT=y
CONFIG_MIPS_CMDLINE_FROM_DTB=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
# Microsecond sleeps (button shift register timing) and tickless idle.
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y
CONFIG_LOCALVERSION="-gb350"

# Core userspace support (Rust/musl needs futex, epoll, etc. - defaults).
# The GB350's static musl binaries use the classic 32-bit time syscalls (nanosleep...);
# allnoconfig drops them (ENOSYS -> Rust's thread::sleep panics in PID 1).
CONFIG_COMPAT_32BIT_TIME=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_TMPFS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE="/work/initramfs.list"
CONFIG_RD_GZIP=y

# Console: no serial yet, so the panel is the console; keep panics on screen.
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_PANIC_TIMEOUT=0
CONFIG_KALLSYMS=y
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FB=y
# Display: KMS driver for the GMA layers (simple-framebuffer until it probes)
CONFIG_DRM=y
CONFIG_DRM_HC16XX=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_CMA_SIZE_MBYTES=24
CONFIG_PWM=y
CONFIG_PWM_HC16XX=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y

# Interrupt controller (drivers/irqchip/irq-hc16xx.c) is always built.
# /dev/mem for the agent's GPIO/register access.
CONFIG_DEVMEM=y

# USB-C as a gadget: MUSB (HC16xx glue, PIO) + configfs + FunctionFS, which
# the agent uses for its control channel to gbctl.
CONFIG_USB_SUPPORT=y
CONFIG_USB_GADGET=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_MUSB_PIO_ONLY=y
CONFIG_USB_PHY=y
CONFIG_NOP_USB_XCEIV=y
CONFIG_CONFIGFS_FS=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y

# SD card: DesignWare MSHC + exFAT (the card is formatted like the stock one).
CONFIG_BLOCK=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_MSDOS_PARTITION=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_PLTFM=y
CONFIG_EXFAT_FS=y
CONFIG_NLS=y
CONFIG_NLS_UTF8=y

# Restart = kexec into the kernel on the card (a chip reset powers the GB350
# off).
CONFIG_KEXEC=y

# GPIO (drivers/gpio/gpio-hc16xx.c) + pin-mux via pinctrl-single (one byte
# per pin); /dev/gpiochipN for userspace.
CONFIG_GPIOLIB=y
CONFIG_GPIO_CDEV=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_SINGLE=y
CONFIG_GPIO_HC16XX=y

# Buttons: shift register (drivers/input/keyboard/gb350-keys.c) + gpio-keys
# for the direct ones (shoulders, volume, Fn, power, headphone switch).
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_KEYBOARD_GB350=y
CONFIG_KEYBOARD_GB350_SYSCORE=y
CONFIG_HWSPINLOCK=y

# Battery: SAR ADC (drivers/iio/adc/hc16xx-adc.c) + battery power supply
# (drivers/power/supply/gb350-battery.c).
CONFIG_IIO=y
CONFIG_HC16XX_ADC=y
CONFIG_POWER_SUPPLY=y
CONFIG_BATTERY_GB350=y

# ============================================================================
# General-purpose userspace support, from the full 7.2.11 menu review
# (tier-B options are the commented "#+" lines).
# CONFIG_USB_MUSB_DUAL_ROLE below replaces CONFIG_USB_MUSB_GADGET (the DT's
# dr_mode = "peripheral" keeps the port a gadget). =m options are built by
# scripts/build-kernel.sh and go on the card in gb350/kmod/.
# ============================================================================

# --- General setup ---------------------------------------------------------
# SysV IPC and POSIX message queues: SDL/PulseAudio-era software, BusyBox/
# procps tools, systemd, X11 shm and many ports expect them.
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
# /proc/config.gz: userspace (and developers) can see exactly what this kernel has.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
# Built-in initramfs compressed with XZ instead of gzip: ~375 KB smaller
# image for ~0.1 s more decompression at boot (RD_GZIP stays for initrds).
CONFIG_RD_XZ=y
CONFIG_INITRAMFS_COMPRESSION_XZ=y
# cgroup v2 basics so systemd (or OpenRC/any service manager) can run; PIDs
# and freezer are cheap. MEMCG deliberately off (see doc).
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
# Namespaces used by systemd sandboxing (PrivateNetwork=, ProtectHostname=,
# PrivateIPC=) and bubblewrap-style tools. USER_NS deliberately off.
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
# Full preemption for input/audio latency (+290 KB on MIPS).
CONFIG_PREEMPT=y
# perf with the 74Kc hardware counters (+102 KB; no cost unless used).
CONFIG_PERF_EVENTS=y
CONFIG_HW_PERF_EVENTS=y

# --- General architecture-dependent options --------------------------------
# Static keys (cheaper disabled tracepoints/debug checks) and seccomp
# (systemd, OpenSSH's sandbox, Flatpak/bubblewrap).
CONFIG_JUMP_LABEL=y
CONFIG_SECCOMP=y

# --- Loadable modules (+254 KB, mostly export tables) -----------------------
# Lets drivers under development (ALSA/DRM/AVP work) be insmod'ed without a
# kexec round-trip, and keeps rarely used drivers off the image.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# --- Block layer -----------------------------------------------------------
# GPT cards (a future rootfs card may well be GPT), mq-deadline for the SD
# card, and writeback throttling so big writes don't starve reads.
CONFIG_EFI_PARTITION=y
CONFIG_MQ_IOSCHED_DEADLINE=y
CONFIG_BLK_WBT=y
CONFIG_BLK_WBT_MQ=y

# --- Memory management -----------------------------------------------------
# Swap (for zram), the upstream defaults allnoconfig turned off (slab
# merging, compaction), and MGLRU, which reclaims better on small-RAM
# devices with zram.
CONFIG_SWAP=y
CONFIG_SLAB_MERGE_DEFAULT=y
CONFIG_COMPACTION=y
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y

# --- Networking (USB gadget networking, ssh, mDNS) --------------------------
# IPv4 + core is ~1 MB and unavoidable for any networking. IPv6 is a bool
# (not modular) in 7.2: tier B, +321 KB (link-local zero-config ssh over the
# USB link; IPv4 with a static address or udhcpd on the device works too).
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IP_MULTICAST=y
CONFIG_IPV6=y
CONFIG_INET_DIAG=m
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
# VPNs / userspace network stacks (WireGuard-go, Tailscale, slirp).
CONFIG_TUN=m

# --- Generic driver options --------------------------------------------------
# /proc/sys/kernel/hotplug for BusyBox mdev; devtmpfs auto-mounted on a
# disk rootfs (no effect on the initramfs).
CONFIG_UEVENT_HELPER=y
CONFIG_DEVTMPFS_MOUNT=y

# --- Block devices -----------------------------------------------------------
# loop: mount squashfs/ext4 images stored on the exFAT partition (a rootfs
# in a file is the easiest way to boot a distro without repartitioning).
# zram: compressed swap in RAM (lz4 default, lzo-rle also available).
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_LZO=y
CONFIG_ZRAM_DEF_COMP_LZ4=y

# --- Input -------------------------------------------------------------------
# uinput: virtual gamepads/keyboards from userspace (key remappers such as
# gptokeyb, RetroArch, the GB350 agent). joydev: legacy /dev/input/js* users.
CONFIG_INPUT_MISC=y
CONFIG_INPUT_UINPUT=y
CONFIG_INPUT_JOYDEV=y

# --- Character devices ---------------------------------------------------------
# 8250 driver (+71 KB) for the DT's UART0/UART1 (UART1 = bootloader
# console on the NOR's WP#/HOLD# pins) as ttyS* / earlycon / console.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y

# --- Graphics --------------------------------------------------------------------
# /dev/fb0 (allnoconfig dropped it): needed by the agent's own screen UI
# (crates/agent/src/fb.rs) and by every fbdev program. fbcon is unaffected.
CONFIG_FB_DEVICE=y

# --- Sound -----------------------------------------------------------------------
# ALSA core now (55 KB), so the coming HC16xx/AVP driver, USB audio and
# userspace all have /dev/snd. aloop gives a userspace-implementable card.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_HC16XX=y
CONFIG_SND_VERBOSE_PROCFS=y
CONFIG_SND_PCM_TIMER=y
CONFIG_SND_HRTIMER=y
CONFIG_SND_PROC_FS=y
CONFIG_SND_CTL_FAST_LOOKUP=y
CONFIG_SND_DRIVERS=y
CONFIG_SND_ALOOP=m

# --- USB: host side (USB-C port in host mode; +168 KB built in) --------------------
# Dual-role MUSB build: with dr_mode = "peripheral" in the DT the controller
# behaves exactly as today (port_mode is taken from the DT); dr_mode = "host"
# gives host mode. Class drivers are modules.
CONFIG_USB=y
CONFIG_USB_MUSB_DUAL_ROLE=y
CONFIG_HID_SUPPORT=y
CONFIG_HID=m
CONFIG_HIDRAW=y
CONFIG_HID_GENERIC=m
CONFIG_USB_HID=m
CONFIG_HID_MICROSOFT=m
CONFIG_HID_NINTENDO=m
CONFIG_HID_PLAYSTATION=m
CONFIG_HID_SONY=m
# The Sony/Nintendo/PlayStation HID drivers need the LED class.
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=m
CONFIG_LEDS_CLASS_MULTICOLOR=m
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_XPAD=m
CONFIG_SCSI=m
CONFIG_BLK_DEV_SD=m
CONFIG_USB_STORAGE=m
CONFIG_USB_UAS=m
CONFIG_USB_NET_DRIVERS=m
CONFIG_USB_USBNET=m
CONFIG_USB_NET_AX8817X=m
CONFIG_USB_NET_AX88179_178A=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_CDC_NCM=m
CONFIG_USB_RTL8152=m
CONFIG_SND_USB=y
CONFIG_SND_USB_AUDIO=m

# --- USB: gadget functions (configfs) -----------------------------------------------
# Networking to the host (NCM for macOS/Linux/Win11, ECM, RNDIS for older
# Windows), a serial console on ttyGS0 (works when the agent is dead:
# console=ttyGS0), mass storage to expose the card, HID to act as a gamepad.
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_U_SERIAL_CONSOLE=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_F_HID=y
# Advertise a realistic bMaxPower (the board charges from VBUS).
CONFIG_USB_GADGET_VBUS_DRAW=500

# --- Userspace I/O -------------------------------------------------------------------
# uio_pdrv_genirq: prototype drivers (e.g. the AVP mailbox, hwirq 66) in Rust
# userspace with real interrupts before writing kernel code.
CONFIG_UIO=y
CONFIG_UIO_PDRV_GENIRQ=y

# --- File systems ----------------------------------------------------------------------
# Built in: FAT32 (SD cards/USB sticks, possibly the boot card itself),
# inotify (systemd, udev, file watchers - allnoconfig dropped it), tmpfs
# ACL/xattr (systemd). Modules: ext4 (+480 KB built in; insmod from the
# initramfs before mounting an ext4 root), FUSE, overlayfs, squashfs, NTFS.
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_INOTIFY_USER=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_EXT4_FS=m
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_FUSE_FS=m
CONFIG_OVERLAY_FS=m
CONFIG_NTFS3_FS=m
# squashfs for read-only images. MISC_FILESYSTEMS is its menu - and also
# PSTORE's: CONFIG_PSTORE* lines are silently dropped without it (that is
# why the earlier pstore/ramoops attempt did not apply).
CONFIG_MISC_FILESYSTEMS=y
CONFIG_SQUASHFS=m
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y

# --- Kernel hacking ------------------------------------------------------------------------
# SysRq via /proc/sysrq-trigger (show tasks, sync, emergency remount), debugfs
# (+94 KB: gpio/pinctrl/clk/musb/regmap state during bring-up), lockup and
# hung-task warnings, symbolic error names in logs.
CONFIG_MAGIC_SYSRQ=y
CONFIG_DEBUG_FS=y
CONFIG_DEBUG_KERNEL=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_SYMBOLIC_ERRNAME=y

# ============================================================================
# Everything else that costs only size (no runtime cost unless used), so the
# kernel stays general purpose (2026-10-16). The bootloader's real limit is
# 64 MB decompressed (CONFIG_SYS_BOOTM_LEN = 0x4000000),
# so size is not a constraint. Still off: PREEMPT (throughput cost),
# stack protector / LSMs / audit (hot-path cost), 8250 console (no wiring).
# ============================================================================
# systemd-style service management: BPF (cgroup device/firewall programs,
# with the MIPS32 JIT), more cgroup controllers, user namespaces, kcmp etc.
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_USER_NS=y
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_CROSS_MEMORY_ATTACH=y
# Memory cgroup: per-page accounting while active, so it is switched off on
# the kernel command line (DT bootargs cgroup_disable=memory); drop that to
# use systemd's MemoryMax= etc.
CONFIG_MEMCG=y
# Pressure stall info (systemd-oomd): off until booted with psi=1.
CONFIG_PSI=y
CONFIG_PSI_DEFAULT_DISABLED=y
# File change notification, autofs (systemd automounts), binfmt_misc.
CONFIG_FANOTIFY=y
CONFIG_DNOTIFY=y
CONFIG_AUTOFS_FS=m
CONFIG_BINFMT_MISC=m
# Memory: userfaultfd (CRIU, some emulators/JITs), KSM and zswap (both idle
# until enabled through sysfs).
CONFIG_USERFAULTFD=y
CONFIG_KSM=y
CONFIG_ZSWAP=y
# F2FS: an SD-card-friendly rootfs option.
CONFIG_F2FS_FS=m
# Firewall / NAT (e.g. sharing a USB Ethernet dongle) and WireGuard, as
# modules: the netfilter core hooks are static keys until a table exists.
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=m
CONFIG_NF_NAT=m
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REJECT=m
CONFIG_WIREGUARD=m
# /dev/input/mice for USB mice in host mode.
CONFIG_INPUT_MOUSEDEV=y
# Runtime-switchable pr_debug/dev_dbg (static keys).
CONFIG_DYNAMIC_DEBUG=y

# ============================================================================
# The remaining options with a runtime cost, enabled on request (2026-10-16):
# full preemption (above), stack protector, audit, LSMs, 8250 console.
# ============================================================================
# Hardening: stack canaries on functions with character arrays. Not the
# -strong variant: with it the running kernel's kexec hangs after "Bye ..."
# every time (bisected 2026-10-16; cause not yet found).
CONFIG_STACKPROTECTOR=y
# CONFIG_STACKPROTECTOR_STRONG is not set
# Audit: compiled in, inactive until an audit daemon enables it.
CONFIG_AUDIT=y
# Security modules: all compiled in; only the cheap ones are active by
# default (CONFIG_LSM). Pick SELinux or AppArmor with the lsm= boot parameter.
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_YAMA=y
CONFIG_LSM="landlock,lockdown,yama"
